# LiveKit Configuration
# Local development setup
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Groq Configuration (Required for LLM)
# Get from https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Google Gemini Configuration (Optional - alternative LLM)
# Get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Deepgram Configuration (Required for Speech-to-Text and Text-to-Speech)
# Get from https://console.deepgram.com
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# OpenAI Configuration (Optional - alternative TTS)
# Get from https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-api-key-here

# Model Selection
# Groq models: llama-3.1-8b-instant, llama-3.1-70b-versatile, mixtral-8x7b-32768
LLM_CHOICE=llama-3.1-8b-instant

# Development Settings
LOG_LEVEL=INFO
DEBUG_MODE=false
